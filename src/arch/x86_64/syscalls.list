# syscalls.list
# <number> <name>   # meaning

0   say        # print (write to default output)
1   halt       # exit process
2   split      # fork process
3   waiton     # wait / waitpid
4   openf      # open file
5   closef     # close file
6   readf      # read from file
7   writef     # write to file
8   opend      # open directory
9   run        # exec / replace process image
10  stop       # kill / signal
11  nap        # sleep
12  sizef      # get the file size
13  csocket    # create socket, returns fd
14  connsock   # connect socket, return 0 on success
15  send       # send bytes on socket
16  recv       # receive bytes from socket
17  closesock  # close socket
18  getdirents # get directory entries